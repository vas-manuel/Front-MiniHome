{
  "$description": "MoniHome – design tokens v2 (formato W3C Design Tokens). Fuente única de verdad para web, app móvil (iOS/Android) y tablet.",
  "color": {
    "brand": {
      "gradient-start": { "$type": "color", "$value": "#0BD2FB", "$description": "Cian del degradado del ícono. Solo decorativo." },
      "gradient-mid":   { "$type": "color", "$value": "#6CC24A", "$description": "Verde del degradado del ícono. Solo decorativo." },
      "gradient-end":   { "$type": "color", "$value": "#FFD801", "$description": "Amarillo del degradado del ícono. Solo decorativo." },
      "logo-blue":      { "$type": "color", "$value": "#0576D4", "$description": "'Moni' del wordmark y cara del ícono." },
      "logo-green":     { "$type": "color", "$value": "#1E8E3E", "$description": "'Home' del wordmark." }
    },
    "light": {
      "primary":            { "$type": "color", "$value": "#0A6CD6", "$description": "Botones y links. Blanco encima = 5.1:1" },
      "primary-hover":      { "$type": "color", "$value": "#0B5BB5" },
      "primary-pressed":    { "$type": "color", "$value": "#0A4D99" },
      "primary-subtle":     { "$type": "color", "$value": "#E6F1FC", "$description": "Fondos de chips, selección" },
      "on-primary":         { "$type": "color", "$value": "#FFFFFF" },

      "success":            { "$type": "color", "$value": "#157A34", "$description": "Estado PAGADA. 5.4:1 sobre blanco, 4.9:1 sobre success-subtle" },
      "success-subtle":     { "$type": "color", "$value": "#E7F6EC" },
      "warning":            { "$type": "color", "$value": "#8A5A00", "$description": "Estado POR VENCER (texto/ícono). 5.9:1 sobre blanco" },
      "warning-subtle":     { "$type": "color", "$value": "#FFF6D6" },
      "danger":             { "$type": "color", "$value": "#C5221F", "$description": "Estado VENCIDA y acciones destructivas. 5.8:1" },
      "danger-subtle":      { "$type": "color", "$value": "#FDECEA" },
      "info":               { "$type": "color", "$value": "#0A6CD6" },
      "info-subtle":        { "$type": "color", "$value": "#E6F1FC" },

      "bg":                 { "$type": "color", "$value": "#F5F6F8" },
      "surface":            { "$type": "color", "$value": "#FFFFFF" },
      "surface-raised":     { "$type": "color", "$value": "#FFFFFF" },
      "border":             { "$type": "color", "$value": "#E2E8F0" },
      "border-strong":      { "$type": "color", "$value": "#CBD5E1" },
      "text":               { "$type": "color", "$value": "#0F172A", "$description": "17.9:1" },
      "text-secondary":     { "$type": "color", "$value": "#475569", "$description": "7.6:1" },
      "text-muted":         { "$type": "color", "$value": "#64748B", "$description": "4.8:1 – mínimo para texto" },
      "focus-ring":         { "$type": "color", "$value": "#0A6CD6" }
    },
    "dark": {
      "primary":            { "$type": "color", "$value": "#4DA3FF", "$description": "Texto #0B1220 encima = 7.1:1" },
      "primary-hover":      { "$type": "color", "$value": "#6BB4FF" },
      "primary-pressed":    { "$type": "color", "$value": "#3A8FE8" },
      "primary-subtle":     { "$type": "color", "$value": "#132A4A" },
      "on-primary":         { "$type": "color", "$value": "#0B1220" },

      "success":            { "$type": "color", "$value": "#4ADE80" },
      "success-subtle":     { "$type": "color", "$value": "#11301F" },
      "warning":            { "$type": "color", "$value": "#FACC15" },
      "warning-subtle":     { "$type": "color", "$value": "#332A0A" },
      "danger":             { "$type": "color", "$value": "#F87171" },
      "danger-subtle":      { "$type": "color", "$value": "#3A1616" },
      "info":               { "$type": "color", "$value": "#4DA3FF" },
      "info-subtle":        { "$type": "color", "$value": "#132A4A" },

      "bg":                 { "$type": "color", "$value": "#0B1220" },
      "surface":            { "$type": "color", "$value": "#16213A" },
      "surface-raised":     { "$type": "color", "$value": "#1C2945" },
      "border":             { "$type": "color", "$value": "#26354F" },
      "border-strong":      { "$type": "color", "$value": "#3A4B68" },
      "text":               { "$type": "color", "$value": "#E5ECF5" },
      "text-secondary":     { "$type": "color", "$value": "#B4C0D0" },
      "text-muted":         { "$type": "color", "$value": "#94A3B8" },
      "focus-ring":         { "$type": "color", "$value": "#4DA3FF" }
    },
    "category": {
      "$description": "Color por tipo de cuenta. 'fg' para el ícono, 'bg' para el contenedor redondeado. Nunca usar como único indicador de estado.",
      "agua":           { "fg": { "$type": "color", "$value": "#0284C7" }, "bg": { "$type": "color", "$value": "#E0F4FE" } },
      "luz":            { "fg": { "$type": "color", "$value": "#A16207" }, "bg": { "$type": "color", "$value": "#FEF7D6" } },
      "gas":            { "fg": { "$type": "color", "$value": "#C2410C" }, "bg": { "$type": "color", "$value": "#FFEDE0" } },
      "internet":       { "fg": { "$type": "color", "$value": "#1D4ED8" }, "bg": { "$type": "color", "$value": "#E5ECFF" } },
      "telefonia":      { "fg": { "$type": "color", "$value": "#4338CA" }, "bg": { "$type": "color", "$value": "#ECEBFF" } },
      "tv-streaming":   { "fg": { "$type": "color", "$value": "#7E22CE" }, "bg": { "$type": "color", "$value": "#F3E8FF" } },
      "gastos-comunes": { "fg": { "$type": "color", "$value": "#0F766E" }, "bg": { "$type": "color", "$value": "#DDF7F3" } },
      "arriendo-dividendo": { "fg": { "$type": "color", "$value": "#15803D" }, "bg": { "$type": "color", "$value": "#E3F6E8" } },
      "educacion":      { "fg": { "$type": "color", "$value": "#B45309" }, "bg": { "$type": "color", "$value": "#FDF0DC" } },
      "seguros-salud":  { "fg": { "$type": "color", "$value": "#BE123C" }, "bg": { "$type": "color", "$value": "#FFE4EA" } },
      "transporte":     { "fg": { "$type": "color", "$value": "#334155" }, "bg": { "$type": "color", "$value": "#E9EEF4" }, "$description": "TAG, permiso de circulación, seguro auto" },
      "otro":           { "fg": { "$type": "color", "$value": "#475569" }, "bg": { "$type": "color", "$value": "#EEF1F5" } }
    }
  },
  "gradient": {
    "brand": { "$type": "gradient", "$value": "linear-gradient(135deg, #0BD2FB 0%, #6CC24A 50%, #FFD801 100%)", "$description": "Solo ícono, splash, hero de la web y momentos de celebración. Nunca detrás de texto pequeño." }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Poppins", "system-ui", "sans-serif"], "$description": "Títulos, marketing, wordmark" },
      "body":    { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"], "$description": "UI, textos, montos (con tabular-nums)" }
    },
    "weight": { "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }, "bold": { "$value": 700 } },
    "scale": {
      "$description": "Tamaños en px (web) = pt (iOS) = sp (Android). line-height en px.",
      "display":  { "size": 40, "lineHeight": 48, "family": "display", "weight": 600 },
      "h1":       { "size": 32, "lineHeight": 40, "family": "display", "weight": 600 },
      "h2":       { "size": 24, "lineHeight": 32, "family": "display", "weight": 600 },
      "h3":       { "size": 20, "lineHeight": 28, "family": "display", "weight": 600 },
      "amount-xl":{ "size": 36, "lineHeight": 44, "family": "body", "weight": 700, "features": "tnum" },
      "amount":   { "size": 18, "lineHeight": 24, "family": "body", "weight": 600, "features": "tnum" },
      "body-lg":  { "size": 17, "lineHeight": 26, "family": "body", "weight": 400 },
      "body":     { "size": 15, "lineHeight": 22, "family": "body", "weight": 400 },
      "label":    { "size": 14, "lineHeight": 20, "family": "body", "weight": 500 },
      "caption":  { "size": 12, "lineHeight": 16, "family": "body", "weight": 500 }
    }
  },
  "space": {
    "$description": "Escala base 4. Usar estos valores para padding, gap y márgenes.",
    "0": { "$value": 0 }, "1": { "$value": 4 }, "2": { "$value": 8 }, "3": { "$value": 12 }, "4": { "$value": 16 },
    "5": { "$value": 20 }, "6": { "$value": 24 }, "8": { "$value": 32 }, "10": { "$value": 40 }, "12": { "$value": 48 }, "16": { "$value": 64 }
  },
  "radius": {
    "sm": { "$value": 8, "$description": "Chips, inputs pequeños" },
    "md": { "$value": 12, "$description": "Botones, inputs" },
    "lg": { "$value": 16, "$description": "Tarjetas" },
    "xl": { "$value": 24, "$description": "Bottom sheets, modales" },
    "full": { "$value": 9999 }
  },
  "elevation": {
    "$description": "Sombras suaves; en modo oscuro se reemplazan por surface-raised + borde.",
    "1": { "$value": "0 1px 2px rgba(15,23,42,0.06), 0 1px 3px rgba(15,23,42,0.08)" },
    "2": { "$value": "0 4px 12px rgba(15,23,42,0.08)" },
    "3": { "$value": "0 12px 32px rgba(15,23,42,0.12)" }
  },
  "motion": {
    "duration": { "fast": { "$value": "120ms" }, "base": { "$value": "200ms" }, "slow": { "$value": "320ms" } },
    "easing": { "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" }, "emphasized": { "$value": "cubic-bezier(0.3, 0, 0, 1.2)" } }
  },
  "size": {
    "touch-target-min": { "$value": 48, "$description": "48dp Android / 44pt iOS mínimo; usar 48 en ambos" },
    "icon-sm": { "$value": 16 }, "icon-md": { "$value": 20 }, "icon-lg": { "$value": 24 }, "category-tile": { "$value": 40 }
  },
  "breakpoint": {
    "mobile": { "$value": 0 },
    "tablet": { "$value": 600, "$description": "Layout de 2 paneles (lista + detalle) desde aquí" },
    "desktop": { "$value": 1024 },
    "wide": { "$value": 1440 }
  }
}
